---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import WorkCard from '../components/WorkCard.astro';
import { works } from '../data/works.js';
---

<BaseLayout
  title="Almira Velasquez — Product Designer & Developer"
  description="Almira Velasquez is a product designer and developer based in Manila, Philippines."
>
  <Hero />

    <section class="featured" id="works">
    <div class="work-grid">
      {works.map((work) => <WorkCard work={work} />)}
    </div>
  </section>
  
</BaseLayout>

<script>
	import '../scripts/role-rotator.js';
</script>