---
import { site } from '../content/index.js';
---

<section class="hero">
  <div class="hero-content">
    <div class="greeting">{site.greeting}!</div>

    <h1>
      {site.headline}
    </h1>

    <div class="hero-location">
      <span class="role-rotator"><span class="role-track">
        {site.roles.map((role, i) => (
          <span class={i === 0 ? 'role is-current' : 'role'} aria-hidden={i === 0 ? 'false' : 'true'}>
            {role.hero}
          </span>
        ))}
      </span></span>

      <span class="hero-place">@ {site.location}</span>
    </div>
  </div>
</section>