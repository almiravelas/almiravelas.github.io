---
import { roles } from '../data/roles.js';
---

<section class="hero">
  <div class="hero-content">
    <div class="greeting">Hello, I’m Almira Velasquez!</div>

    <h1>
      I turn complex, emerging tech into delightful, accessible experiences.
    </h1>

    <div class="hero-location">
      <span class="role-rotator"><span class="role-track">
        {roles.map((role, i) => (
          <span class={i === 0 ? 'role is-current' : 'role'} aria-hidden={i === 0 ? 'false' : 'true'}>
            {role.hero}
          </span>
        ))}
      </span></span>

      <span class="hero-place">@ Manila, Philippines</span>
    </div>
  </div>
</section>