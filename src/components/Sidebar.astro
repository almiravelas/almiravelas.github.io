---
import { site } from '../content/index.js';
---

<aside class="scroll-identity" aria-label={site.name}>
  <a class="identity-name" href="#" data-tip="home">{site.name}</a>
  <div class="identity-role">
    <span class="side-rotator"><span class="side-track">
      {site.roles.map((role, i) => (
        <span class={i === 0 ? 'side-role is-current' : 'side-role'} aria-hidden={i === 0 ? 'false' : 'true'}>
          <Fragment set:html={role.side} />
        </span>
      ))}
    </span></span>
  </div>
  <div class="identity-note">{site.location}</div>
  <div class="identity-socials">
    <a href={`mailto:${site.email}`} aria-label="Email">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2.5" y="5" width="19" height="14" rx="2"/><path d="m3.5 7.5 8.5 6 8.5-6"/></svg>
    </a>
    <a href={site.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="4.6" cy="4.8" r="1.6"/><rect x="3" y="9" width="3.2" height="11.5"/><path d="M10 20.5V9h3.1v1.7c.6-1.1 1.9-2 3.7-2 3 0 4.2 1.9 4.2 5v6.8h-3.2v-6.2c0-1.6-.6-2.5-2-2.5-1.5 0-2.4 1-2.4 2.6v6.1z"/></svg>
    </a>
  </div>
  <nav class="identity-menu" aria-label="Menu">
    {site.menu.map((item) => <a href={item.href}>{item.label}</a>)}
  </nav>
</aside>